DASHSCOPE_API_KEY=your_dashscope_api_key_here
PORT=3001
QWEN_MODEL=qwen3.7-plus

# AMD Cloud Assist / Fireworks AI route.
# Keep this key server-side only. Do not expose it in frontend code.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# Optional. Use the endpoint for your Alibaba Cloud Model Studio region.
# International:
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# US (Virginia):
# DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
#
# Workspace-specific Singapore endpoint:
# DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
